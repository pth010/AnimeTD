local bagBack = Instance.new("Frame")
bagBack.Position = UDim2.fromOffset(12, 12)
bagBack.Size = UDim2.new(1, -24, 1, -24)
bagBack.BackgroundColor3 = Color3.fromRGB(12, 10, 26)
